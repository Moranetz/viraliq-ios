default_platform(:ios)

# ViralIQ — fastlane configuration. ASC API key auth, never interactive 2FA.

API_KEY_PATH = ENV["ASC_API_KEY_PATH"] || File.expand_path("~/.appstoreconnect/private_keys/AuthKey_RQ97N8T3M4.p8")
API_KEY_ID   = ENV["ASC_API_KEY_ID"]   || "RQ97N8T3M4"
API_ISSUER   = ENV["ASC_API_ISSUER"]   || ENV["APP_STORE_CONNECT_API_ISSUER"]

def asc_api_key
  app_store_connect_api_key(
    key_id: API_KEY_ID,
    issuer_id: API_ISSUER,
    key_filepath: API_KEY_PATH,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "TestFlight upload"
  lane :beta do
    key = asc_api_key
    increment_build_number(
      xcodeproj: "ViralIQ.xcodeproj",
      build_number: latest_testflight_build_number(
        api_key: key,
        app_identifier: "com.melmarion.viraliq",
        initial_build_number: 0
      ) + 1
    )
    build_app(
      project: "ViralIQ.xcodeproj",
      scheme: "ViralIQ",
      configuration: "Release",
      export_method: "app-store",
      export_options: "./ExportOptions.plist",
      output_directory: "./build",
      output_name: "ViralIQ.ipa",
      clean: true,
      include_bitcode: false,
      xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      api_key: key,
      ipa: "./build/ViralIQ.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Initial TestFlight build."
    )
  end

  desc "Upload App Store metadata only"
  lane :meta do
    key = asc_api_key
    upload_to_app_store(
      api_key: key,
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

  desc "Pre-flight gate"
  lane :preflight do
    sh "../scripts/preflight_check.sh"
    build_app(
      project: "../ViralIQ.xcodeproj",
      scheme: "ViralIQ",
      configuration: "Debug",
      destination: "platform=iOS Simulator,name=iPhone 17 Pro",
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true
    )
  end
end
